// Update godoc
// @Summary     Update {{.Package}}
// @Description Update an existing {{.Package}}
// @ID          {{.Package}}-update
// @Tags        {{.Package}}s
// @Accept      json
// @Produce     json
// @Param       id path int true "{{.Entity}} ID"
// @Param       request body {{.Package}}dto.UpdateRequest true "Update {{.Entity}} request"
// @Success     200 {object} response.Response[{{.Package}}dto.Response]
// @Failure     400 {object} response.ErrorResponse
// @Failure     404 {object} response.ErrorResponse
// @Failure     500 {object} response.ErrorResponse
// @Router      /{{.Variable}}s/{id} [put]
func (h *Handler) Update(ctx *fiber.Ctx) error {
	id, err := strconv.ParseUint(ctx.Params("id"), 10, 32)
	if err != nil {
		return response.BadRequest(ctx, "INVALID_ID", "Invalid {{.Package}} ID")
	}

	var req {{.Package}}dto.UpdateRequest
	if err := ctx.BodyParser(&req); err != nil {
		return response.BadRequest(ctx, "INVALID_JSON", "Invalid request body")
	}

	if err := h.v.Struct(req); err != nil {
		return response.ValidationError(ctx, v1.ParseValidationErrors(err))
	}

	result, err := h.{{.Variable}}UC.Update(ctx.UserContext(), uint(id), req)
	if err != nil {
		if errors.Is(err, {{.Package}}uc.ErrNotFound) {
			return response.NotFound(ctx, "{{.Entity}} not found")
		}
		h.l.Error(err, "handlers - http - v1 - {{.Package}} - Update")
		return response.InternalError(ctx)
	}

	return response.OK(ctx, result)
}
