package http

import (
	"net/http"
	"net/http/httptest"

	"github.com/go-playground/validator/v10"

	v1 "go-boilerplate/internal/handlers/http/v1"
	"go-boilerplate/pkg/httpserver"
	"go-boilerplate/pkg/logger"
	"go-boilerplate/pkg/request"
	"go-boilerplate/pkg/response"
)

func newTestClient() *http.Client {
	l := logger.New("error")
	srv := httpserver.New(l)
	NewRouter(srv, l)
	validate := validator.New()
	srv.App.HandleFunc("POST /echo", func(w http.ResponseWriter, r *http.Request) {
		var input echoInput
		if err := request.Body(r, &input); err != nil {
			response.BadRequest(w, r, "INVALID_BODY", "Invalid JSON body")
			return
		}
		if err := validate.Struct(input); err != nil {
			response.ValidationError(w, r, v1.ParseValidationErrors(err))
			return
		}
		response.OK(w, r, input)
	})
	srv.App.HandleFunc("GET /panic", func(_ http.ResponseWriter, _ *http.Request) { panic("private-panic") })
	return &http.Client{Transport: testTransport(func(req *http.Request) (*http.Response, error) {
		recorder := httptest.NewRecorder()
		srv.Handler.ServeHTTP(recorder, req)
		return recorder.Result(), nil
	})}
}
