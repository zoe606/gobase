package translation

import (
	"net/http"

	"github.com/go-playground/validator/v10"

	"go-boilerplate/internal/handlers/http/routing"
	"go-boilerplate/internal/usecase"
	"go-boilerplate/pkg/logger"
)

// Handler handles translation endpoints.
type Handler struct {
	translationUC usecase.Translation
	l             logger.Interface
	v             *validator.Validate
}

// New creates a new translation handler.
func New(translationUC usecase.Translation, l logger.Interface) *Handler {
	return &Handler{
		translationUC: translationUC,
		l:             l,
		v:             validator.New(validator.WithRequiredStructEnabled()),
	}
}

// RegisterRoutes sets up translation routes.
func (h *Handler) RegisterRoutes(router *routing.Router) {
	translation := router.Group("/translation")
	{
		translation.Handle("GET", "/history", http.HandlerFunc(h.History))
		translation.Handle("POST", "/do-translate", http.HandlerFunc(h.Translate))
	}
}
